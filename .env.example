# Supabase Cloud
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Adapter (true = SupabaseAdapter, false = LocalAdapter)
VITE_SUPABASE_ADAPTER=false

# Test user (solo para tests de integración)
VITE_TEST_USER_EMAIL=test@example.com
VITE_TEST_USER_PASSWORD=your-test-password
