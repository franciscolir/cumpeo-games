import { describe, it, expect, beforeAll, afterAll } from 'vitest';
import { SupabaseAdapter } from '../../../src/adapters/SupabaseAdapter.js';

const TIENE_CREDENCIALES =
  !!import.meta.env.VITE_SUPABASE_URL && !!import.meta.env.VITE_SUPABASE_ANON_KEY;

const describeSiCredenciales = TIENE_CREDENCIALES ? describe : describe.skip;

let adapter;
let juegoIdReal;

beforeAll(async () => {
  if (!TIENE_CREDENCIALES) return;
  adapter = new SupabaseAdapter();
  await adapter.abrir();

  const juegos = await adapter.query('juegos', { limit: 1 });
  if (juegos.length > 0) {
    juegoIdReal = juegos[0].id;
  }
});

afterAll(async () => {
  if (adapter) await adapter.cerrar();
});

describeSiCredenciales('SupabaseAdapter.suscribir (integración)', () => {
  it('suscribir y recibir evento UPDATE', { retry: 3 }, async () => {
    if (!juegoIdReal) return;

    let eventoRecibido = null;
    const unsuscribe = await adapter.suscribir(
      'juegos',
      { filter: `id=eq.${juegoIdReal}`, event: 'UPDATE' },
      (payload) => { eventoRecibido = payload; }
    );

    const original = await adapter.query('juegos', { eq: { id: juegoIdReal }, single: true });
    await adapter.update(
      'juegos',
      { eq: { id: juegoIdReal } },
      { nombre: `${original.nombre}_rt_${Date.now()}` }
    );

    await new Promise((r) => setTimeout(r, 3000));

    await adapter.update('juegos', { eq: { id: juegoIdReal } }, { nombre: original.nombre });

    unsuscribe();

    expect(eventoRecibido).toBeTruthy();
    expect(eventoRecibido.eventType).toBe('UPDATE');
  }, 20000);

  it('desuscribir deja de recibir eventos', async () => {
    if (!juegoIdReal) return;

    let eventosDespues = 0;
    const unsuscribe = await adapter.suscribir(
      'juegos',
      { event: 'UPDATE' },
      () => { eventosDespues++; }
    );

    unsuscribe();

    const original = await adapter.query('juegos', { eq: { id: juegoIdReal }, single: true });
    await adapter.update(
      'juegos',
      { eq: { id: juegoIdReal } },
      { nombre: `${original.nombre}_rt2_${Date.now()}` }
    );

    await new Promise((r) => setTimeout(r, 2000));

    await adapter.update('juegos', { eq: { id: juegoIdReal } }, { nombre: original.nombre });

    expect(eventosDespues).toBe(0);
  }, 15000);

  it('cleanup no falla si se llama dos veces', async () => {
    const unsuscribe = await adapter.suscribir(
      'juegos',
      { event: 'UPDATE' },
      () => {}
    );

    unsuscribe();
    expect(() => unsuscribe()).not.toThrow();
  }, 5000);
});
